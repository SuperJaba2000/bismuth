{
    player_box: {
        top: "100%-3",
        left: 2,
        width: "100%-3",
        height: 3,
        content: " ♫ ",
        //content: " > ",
        shadow: false,
        border: {
            type: "line"
        },
        style: {
            fg: "green",
            border: {
                fg: "white",
            },
        }
    },

    button_play: {
        top: 0,
        // TODO : try to centrate with align
        left: "50%-3",
        width: 5,
        height: 1,
        // generate content in script
        //content: _button_play_content(),
        tags: true,
        align: "center",
        style: {
            hover: {
                bg: "gray"
            }
        }
    },

    button_prev: {
        top: 0,
        // TODO : try to centrate with align
        left: "50%-7",
        //left: "40%",
        width: 4,
        height: 1,
        // generate content in script
        //content: _button_prev_content(),
        tags: true,
        //align: center,
        style: {
            hover: {
                bg: "gray"
            }
        }
    },

    button_next: {
        top: 0,
        // TODO : try to centrate with align
        left: "50%+2",
        //left: "60%",
        width: 4,
        height: 1,
        // generate content in script
        //content: _button_prev_content(),
        tags: true,
        align: "center",
        style: {
            hover: {
                bg: "gray"
            }
        }
    },

    track_time: {
        top: 0,
        left: "100%-14",
        width: 11,
        height: 1,
        content: "00:00|00:00",
        align: "center",
        style: {
            fg: "white",
            hover: {
                bg: "gray"
            }
        }
    },

    track_title: {
        top: 0,
        left: 3,
        width: 11,
        height: 1,
        content: "Track title",
        //align: center,
        style: {
            fg: "white",
            hover: {
                underline: true
            }
        }
    },

    track_artist: {
        top: 0,
        left: 15,
        width: 11,
        height: 1,
        content: "- artist",
        //align: center,
        style: {
            fg: "#aaaaaa",
            hover: {
                fg: "white"
            }
        }
    },

    progress_bar: {
        top: -2,
        left: 0,
        height: 2,
        tags: true,
        width: "100%-2",
        style: {
            fg: "#ffffaa",
        }
    },

    button_repeat_type: {
        top: 0,
        left: "100%-20",
        width: 5,
        height: 1,
        // generate content in script
        //content: _button_repeat_type_content(),
        tags: true,
        align: "center",
        style: {
            hover: {
                bg: "gray"
            }
        }
    }
}