{
    "player-box": {
        top: "100%-3",
        left: 2,
        width: "100%-3",
        height: 3,
        content: " ♫ ",
        //content: " > ",
        shadow: false,
        border: {
            type: "line"
        },
        style: {
            fg: "green",
            border: {
                fg: "white",
            },
        }
    },

    "button-play": {
        top: 0,
        // TODO : try to centrate with align
        left: "50%-3",
        width: 5,
        height: 1,
        // generate content in script
        //content: _button_play_content(),
        tags: true,
        align: "center",
        style: {
            hover: {
                bg: "gray"
            }
        }
    },

    "button-prev": {
        top: 0,
        // TODO : try to centrate with align
        left: "50%-7",
        //left: "40%",
        width: 4,
        height: 1,
        // generate content in script
        //content: _button_prev_content(),
        tags: true,
        //align: center,
        style: {
            hover: {
                bg: "gray"
            }
        }
    },

    "button-next": {
        top: 0,
        // TODO : try to centrate with align
        left: "50%+2",
        //left: "60%",
        width: 4,
        height: 1,
        // generate content in script
        //content: _button_prev_content(),
        tags: true,
        align: "center",
        style: {
            hover: {
                bg: "gray"
            }
        }
    },

    "track-time": {
        top: 0,
        left: "100%-14",
        width: 11,
        height: 1,
        content: "00:00|00:00",
        align: "center",
        style: {
            fg: "white",
            hover: {
                bg: "gray"
            }
        }
    },

    "track-title": {
        top: 0,
        left: 3,
        width: 11,
        height: 1,
        content: "Track title",
        //align: center,
        style: {
            fg: "white",
            hover: {
                underline: true
            }
        }
    },

    "track-artist": {
        top: 0,
        left: 15,
        width: 11,
        height: 1,
        content: "- artist",
        //align: center,
        style: {
            fg: "#aaaaaa",
            hover: {
                fg: "white"
            }
        }
    },

    "progress-bar-char0": "━",
    "progress-bar-char1": "━",
    "progress-bar-color0": "white",
    "progress-bar-color1": "yellow",

    "progress-bar-box": {
        top: -2,
        left: 0,
        height: 2,
        tags: true,
        width: "100%-2",
        style: {
            fg: "#ffffaa",
        }
    },

    "button-repeat-type": {
        top: 0,
        left: "100%-20",
        width: 5,
        height: 1,
        // generate content in script
        //content: _button_repeat_type_content(),
        tags: true,
        align: "center",
        style: {
            hover: {
                bg: "gray"
            }
        }
    }
}