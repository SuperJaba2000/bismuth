{
    "tab1-playlist-header": {
        top: 1,
        left: 1,
        width: 20,
        height: 2,
        align: "center",
        content: "{center}current playlist{/center}\n{gray-fg}⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─⁠─",
        tags: true,
        style: {
            fg: "#ffffaa",
            //bg: "#00ab94"
        }
    },

    "tab1-playlist": {
        top: 4,
        left: 1,
        width: 20,
        keys: {},
        vi: false,
        mouse: true,
        height: "100%-8",
        style: {
            //bg: "red",
            item: {
                fg: "white",
                
            },
            selected: {
                bg: "#1fab00",
                fg: "black"
            }
        }
    },

    "tab1-separator": {
        orientation : "vertical",
        top: 1,
        left: 30,
        height: "100%-5",
        style: {
            fg: "gray",
        },
        draggable: true
    },

    "tab1-filemanager": {
        top: 1,
        left: 32,
        width: "shrink",
        keys: {},
        vi: false,
        mouse: true,
        height: "100%-5",
        style: {
            item: {
                fg: "white",
                
            },
            selected: {
                bg: "#bcbcbc",
                fg: "black"
            }
        }
    }
}