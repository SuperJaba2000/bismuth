{
    "fg-color-inactive": "#999999",

    // TODO : move to another file
    "button-play-main-fg": "yellow",
    "button-play-border-fg": "#ffffaa",
    
    "buttons-prev-next-fg": "yellow",

    "button-repeat-type-fg": "green",
    
    "progress-bar-fg-active": "yellow",
    "progress-bar-fg-inactive": "#ffffaa",


    "message-box": {
        top: "50%-3",
        left: "50%-13",
        width: 26,
        height: 3,
        align: "center",
        tags: true,
        index: 9999,
 
        border: {
            type: "line"
        },

        style: {
            fg: "white",
            bg: "gray",
            border: {
                fg: "magenta",
            },
        }
    },

    "background-box": {
        top: 0,
        left: 0,
        width: "100%",
        height: "100%",
        bg: "black"
    }
}